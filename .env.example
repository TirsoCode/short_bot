# Database (la app guarda la DB en el directorio temporal del sistema)
DATABASE_URL=file:./data/shortbot.db

# Login de la app (dashboard). Genera un secreto fuerte y ponlo aquí
# (o como variable de entorno / GitHub secret en producción)
LOGIN_PASSWORD=change-me-a-long-random-secret

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-this-to-a-random-secret

# YouTube OAuth (create at console.cloud.google.com)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# GitHub (opcional: solo si vas a seguir importando medios desde GitHub)
GITHUB_TOKEN=